{
  "name": "amgsquant-print-system",
  "version": "1.0.0",
  "private": true,
  "description": "System zarządzania drukarnią wielkoformatową - Sklep + Zarządzanie produkcją",
  "author": "AMGSquant",
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @amgsquant/database migrate",
    "db:seed": "pnpm --filter @amgsquant/database seed",
    "db:studio": "pnpm --filter @amgsquant/database studio"
  },
  "devDependencies": {
    "turbo": "^1.11.0",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
