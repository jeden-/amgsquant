# Database
DATABASE_URL="postgresql://printuser:printpass@localhost:5432/printdb"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# RabbitMQ
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# MinIO / S3
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_FILES="print-files"
MINIO_BUCKET_THUMBNAILS="print-thumbnails"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Backend
BACKEND_PORT=4000
BACKEND_URL="http://localhost:4000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Payment (Stripe/PayU)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""

# Shipping (InPost/DPD)
INPOST_API_KEY=""
DPD_API_KEY=""

# Invoicing
WFIRMA_API_KEY=""

# Email (SendGrid/SMTP)
EMAIL_HOST=""
EMAIL_PORT=587
EMAIL_USER=""
